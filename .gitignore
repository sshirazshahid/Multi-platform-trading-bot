# OS-generated files
.DS_Store
Thumbs.db

# Python cache & build artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.so
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Secrets & local config (NEVER commit — contains live API keys)
.env
.env.*
!.env.example
.claude/settings.local.json

# Tool configurations
.idea/
.vscode/
.envrc
.mcp.json

# Logs & temp
logs/
*.log
*.tmp

# Jupyter
.ipynb_checkpoints/

# Generated reports
reports/

# Kronos foundation-model eval (weights + cloned source; vendored model code IS committed)
models/kronos/
.kronos_src/
vendor/kronos/**/__pycache__/

# Derivs harvester forward-accumulation store (grows over time; runtime data)
data/derivs_history.jsonl

# Transient agent / tool state (Ruflo swarm, worktrees, vector + agent DBs)
.claude-flow/
.swarm/
.claude/worktrees/
.pytest_tmp/
agentdb.rvf
agentdb.rvf.lock
ruvector.db

# SQLite transient files + backups (never commit — DB internals / large)
data/*.sqlite-shm
data/*.sqlite-wal
data/*.sqlite.bak*
data/*.sqlite-bak*

# Regenerable runtime caches / trained-model artifacts
data/ohlcv_cache/
data/models/

# CI artifacts
htmlcov/
.coverage
# .secrets.baseline is tracked — needed by detect-secrets pre-commit hook
