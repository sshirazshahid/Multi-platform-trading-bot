# ============================================================
# TRADING BOT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control (.env is gitignored).
# ============================================================
#
# Minimum for Binance + Bybit + Bitget (spot + futures):
#   BINANCE_* , BYBIT_* , BITGET_* (+ BITGET_PASSPHRASE)
# MEXC is optional — leave MEXC_* empty to skip that exchange.
#
# Before live money: keep DRY_RUN=true until you validate scans and paper fills.
# ============================================================

# --- BINANCE ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true          # Set to false for live trading

# --- MEXC ---
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET_KEY=your_mexc_secret_key_here
MEXC_TESTNET=true             # Set to false for live trading

# --- EMAIL NOTIFICATIONS via Gmail SMTP (optional but recommended) ---
# Use a Gmail App Password — NOT your regular Gmail password.
# How to get one:
#   1. Enable 2-Step Verification: myaccount.google.com/security
#   2. Go to: myaccount.google.com/apppasswords
#   3. Select "Mail" -> generate -> copy the 16-char code below
GMAIL_SENDER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECIPIENT=alerts_destination@gmail.com
EMAIL_SUBJECT_PREFIX=[TradingBot]

# --- GENERAL SETTINGS ---
DRY_RUN=true                  # true = simulate trades, false = real trades
LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR
