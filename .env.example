# Trading Bot configuration template
# Copy to .env and keep that file private. Never commit real credentials.

# Safety defaults: observation/shadow only. Changing these values does not by
# itself authorize CONTROLLED_LIVE; live mode also requires the signed approval
# artifact, runtime invariants, strategy readiness, venue preflight, and model
# readiness gates.
OPERATING_MODE=PAPER
# STANDARD or AGGRESSIVE_RESEARCH. Aggressive is PAPER-only and doubles
# research slots while halving per-trade risk; aggregate risk stays unchanged.
PAPER_TRADING_PROFILE=STANDARD
CONTROLLED_LIVE_ENABLED=false
# DRY_RUN is DERIVED from OPERATING_MODE in config.py (True unless CONTROLLED_LIVE).
# Leaving this line is harmless documentation — config does not read DRY_RUN from env.
# DRY_RUN=true

# Mission Control WebUI (python scripts/run_mission_control.py → http://127.0.0.1:8787)
# Required non-empty token. Binds loopback only unless MISSION_CONTROL_ALLOW_LAN=1.
MISSION_CONTROL_TOKEN=
MISSION_CONTROL_HOST=127.0.0.1
MISSION_CONTROL_PORT=8787
MISSION_CONTROL_ALLOW_LAN=false

# Universe Flow Loosen V1 (PAPER only): mild spread/depth/chop loosen for 7 days.
# Keep BAND_REGIME_FILTER_ENABLED=true for WR protection. Review after 7d:
#   python scripts/review_universe_flow_loosen.py
UNIVERSE_FLOW_LOOSEN_V1=false

# Shadow probes (log-only). Pullback MA20/RSI14 RETIRED NO-PROMOTE 2026-07-30 —
# keep false unless a new hashed prereg + dual-agree reopen clears.
SHADOW_PULLBACK_PROBE_ENABLED=false

# AccBand / max-flow PAPER: leave scalp OFF unless a quiet-regime hashed
# prereg says otherwise — SCALP_MODE ATR veto can zero the allow funnel.
SCALP_MODE_ENABLED=false
# Leverage SCALP tier — default OFF (no live scalp without after-cost GO).
SCALP_TIER_ENABLED=false

# Blueprint Phase 1 ops: warehouse orphan auto-close (default on under PAPER).
# WAREHOUSE_ORPHAN_AUTO_CLOSE=true
# Soft outage flatten losers — default OFF (block entries via soft-stale latch).
OUTAGE_FLATTEN_LOSERS_ENABLED=false

ENTRY_POLICY=SHADOW_ONLY
APPROVED_PAPER_STRATEGIES=
APPROVED_LIVE_STRATEGIES=
LIVE_ENTRY_APPROVAL_PATH=data/live_entry_approval.json

# Exchange credentials. Use trade-only keys with withdrawals disabled and IP
# restrictions where possible. Empty keys keep private-account features off.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=false
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Bitget Unified Trading Account. auto = detect 40085 and rebuild ccxt with uta=True.
# true = always UTA endpoints; false = classic only (fails on UTA accounts).
BITGET_UTA=auto

# Notifications and optional external analysis.
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=
EMAIL_SUBJECT_PREFIX=[TradingBot]
ANTHROPIC_API_KEY=
CRYPTOCOMPARE_API_KEY=
COINDESK_API_KEY=

# Whale / large-transfer harvest (LOG-ONLY — RECORD-NO-ACTION for live wire).
# Optional Whale Alert REST key. Without it the harvester still accrues unlabeled
# large BTC mempool txs via blockchain.info. Never authorizes MCP entries.
# WHALE_ALERT_API_KEY=
# WHALE_MIN_USD=1000000
# WHALE_EVENTS_INBOX=data/whale_events_inbox
# Run: python scripts/harvest_whale_events.py --once

# X/Twitter curated crypto accounts → news headlines (advisory only).
# Preferred: X API v2 bearer token (developer.x.com). Without a token the
# scanner tries RSSHub mirrors when TWITTER_RSS_FALLBACK=true (flaky).
# TWITTER_ACCOUNTS=whale_alert,lookonchain,CoinDesk  # optional override
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
TWITTER_NEWS_ENABLED=true
TWITTER_RSS_FALLBACK=true
TWITTER_MAX_RESULTS=20
# TWITTER_RSSHUB_BASE=https://rsshub.app

# Runtime defaults.
LOG_LEVEL=INFO
TRADING_MODE=usdt_only
PORTFOLIO_MIN_VALUE_USD=2.0
PORTFOLIO_RESCAN_MINUTES=60
DRY_RUN_BALANCE=100.0

# Signal/model defaults remain non-executable until evidence is promoted.
SIGNAL_SOURCE=mcp
MODEL_GATE_ENABLED=true
MODEL_GATE_SHADOW=true
MODEL_GATE_THRESHOLD_FUTURES=0.55
MODEL_GATE_THRESHOLD_SPOT=0.58
# Final MCP_DIRECTIONAL_PAPER execution admission. These are fixed stress and
# uncertainty margins, not win-rate or SL/TP tuning controls. Missing/unpromoted
# model probabilities and non-positive stressed after-cost EV fail closed.
MCP_DIRECTIONAL_ECONOMIC_PROBABILITY_MARGIN=0.03
MCP_DIRECTIONAL_ECONOMIC_FEE_STRESS_MULT=1.5
MCP_DIRECTIONAL_ECONOMIC_SLIPPAGE_STRESS_MULT=2.0
# strict (default) requires a promoted model probability (fail-closed).
# paper_fallback — honored ONLY under PAPER + MAX_FLOW_BAND — skips the model
# term when no promoted model exists and admits iff the bracket clears the
# stressed geometric breakeven (breakeven WR < 1.0). Never fakes a model.
MCP_DIRECTIONAL_ECONOMIC_GATE_MODE=strict
# AccBand / MCP directional RESEARCH tuition cap (PAPER + MAX_FLOW_BAND only).
# Soft ceiling on NEW directional opens per UTC day — not an edge claim.
# Ignored outside PAPER+MAX_FLOW_BAND. Does not apply to F1 carry.
ACCBAND_RESEARCH_MAX_OPENS_UTC_DAY=12
MACHINE_STRATEGY_RUNTIME_MODE=paper_shadow
DEEP_BREAKOUT_LANE_ENABLED=false

# Broad read-only USDT-perpetual screening. This feeds only the shadow research
# lane; it never expands the executable pair list.
BROAD_UNIVERSE_MONITOR_ENABLED=true
BROAD_UNIVERSE_MONITOR_DB_PATH=data/universe_monitor.sqlite
BROAD_UNIVERSE_MIN_QUOTE_VOLUME_USDT=5000000
BROAD_UNIVERSE_MAX_TICKER_AGE_S=180
BROAD_UNIVERSE_REFERENCE_TOLERANCE_S=1800
BROAD_UNIVERSE_RETENTION_DAYS=8
BROAD_UNIVERSE_PER_DIRECTION=3
BROAD_UNIVERSE_SHORTLIST_CAP=18
BROAD_UNIVERSE_MAX_CONTRACTS_PER_VENUE=5000
# Absolute USDT move band for shadow shortlist (mid-priced movers ~$5–$200).
# Research/telemetry only — does not expand live TRADING_PAIRS.
BROAD_UNIVERSE_ABS_MOVE_USDT_MIN=5
BROAD_UNIVERSE_ABS_MOVE_USDT_MAX=200
BROAD_UNIVERSE_PREFER_ABS_USDT_RANK=true

# Execution and data-integrity safety rails.
MAKER_ONLY_ENABLED=true
SLTP_TRIGGER_MARK_PRICE=true
SL_FAIL_EMERGENCY_CLOSE_ENABLED=true
OHLCV_VALIDATION_ENABLED=true
CLOCK_DRIFT_ALERT_MS=500
EXECUTION_BOOK_MAX_AGE_SEC=5
MAX_ENTRY_SLIPPAGE_BPS=30
