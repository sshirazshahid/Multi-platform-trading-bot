//@version=6
// =============================================================================
// QuantSuite #1 - Multi-Factor (MCP-Brain port)  |  INDICATOR (alerts/webhook)
// Same signal logic as 01_multifactor_strategy.pine, but emits alerts you can
// route to a webhook (e.g. your bot). Run on the 1h timeframe.
// =============================================================================
indicator("QuantSuite #1 Multi-Factor [signals]", overlay=true)

gT = "Timeframes"
htf    = input.timeframe("240", "Higher TF (trend context)", group=gT)
// default OFF: matches the Python engine (no 15m gate); on long histories missing
// 15m data coerces the bool to false and would block ALL longs / pass ALL shorts.
useLTF = input.bool(false, "Use lower-TF timing filter", group=gT)
ltf    = input.timeframe("15", "Lower TF (entry timing)", group=gT)
gS = "Signal"
emaFastLen = input.int(20, "EMA fast", group=gS)
emaSlowLen = input.int(50, "EMA slow", group=gS)
rsiLen     = input.int(14, "RSI length", group=gS)
adxLen     = input.int(14, "ADX / DMI length", group=gS)
adxMin     = input.float(20.0, "ADX minimum", group=gS)
emaGapMin  = input.float(0.15, "4h EMA gap min (%)", group=gS)
volLen     = input.int(20, "Volume MA length", group=gS)
vwapLen    = input.int(24, "Rolling VWAP length", group=gS)
scoreThr   = input.int(65, "Entry score threshold", minval=50, maxval=84, group=gS)
gR = "Risk (for alert SL/TP)"
atrLen   = input.int(14, "ATR length", group=gR)
atrMult  = input.float(1.5, "ATR x for stop", group=gR)
slMinPct = input.float(1.5, "Min stop (%)", group=gR) / 100.0
slMaxPct = input.float(3.5, "Max stop (%)", group=gR) / 100.0
rr       = input.float(2.5, "Reward : Risk", group=gR)
allowLong  = input.bool(true, "Allow longs", group=gR)
allowShort = input.bool(true, "Allow shorts", group=gR)

ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaSlowLen)
rsiV  = ta.rsi(close, rsiLen)
[diP, diM, adxV] = ta.dmi(adxLen, adxLen)
atrV  = ta.atr(atrLen)
hlc3v = (high + low + close) / 3.0
rvwap = math.sum(hlc3v * volume, vwapLen) / math.sum(volume, vwapLen)
volRatio = volume / ta.sma(volume, volLen)
pvw   = (close - rvwap) / rvwap * 100.0

ema20H = request.security(syminfo.tickerid, htf, ta.ema(close, emaFastLen)[1], lookahead=barmerge.lookahead_on)
ema50H = request.security(syminfo.tickerid, htf, ta.ema(close, emaSlowLen)[1], lookahead=barmerge.lookahead_on)
ema20Hp = request.security(syminfo.tickerid, htf, ta.ema(close, emaFastLen)[4], lookahead=barmerge.lookahead_on)
slopeUp = ema20H > ema20Hp
slopeDn = ema20H < ema20Hp
ltfBull = request.security(syminfo.tickerid, ltf, ta.ema(close, emaFastLen) > ta.ema(close, emaSlowLen))

emaGap  = na(ema50H) or ema50H == 0 ? 0.0 : math.abs(ema20H - ema50H) / ema50H * 100.0
side    = ema20H > ema50H ? 1 : (ema20H < ema50H ? -1 : 0)
r1 = emaGap >= emaGapMin
r2 = side == 1 ? (ema20 > ema50) : (ema20 < ema50)
r3 = side == 1 ? (rsiV >= 38 and rsiV <= 68) : (rsiV >= 32 and rsiV <= 62)
r4 = adxV >= adxMin
reqPass = r1 and r2 and r3 and r4 and side != 0

hhv = ta.highest(high, 5) > ta.highest(high, 5)[5]
hlv = ta.lowest(low, 5)  > ta.lowest(low, 5)[5]
llv = ta.lowest(low, 5)  < ta.lowest(low, 5)[5]
lhv = ta.highest(high, 5) < ta.highest(high, 5)[5]
bSlope = ((side == 1 and slopeUp) or (side == -1 and slopeDn)) ? 3.0 : 0.0
bVol   = volRatio >= 1.2 ? 8.0 : 0.0
bStruct = ((side == 1 and hhv and hlv) or (side == -1 and llv and lhv)) ? 8.0 : 0.0
bVwap  = ((side == 1 and pvw > 0.05 and pvw < 2.0) or (side == -1 and pvw < -0.05 and pvw > -2.0)) ? 15.0 : 0.0
score  = reqPass ? (50.0 + bSlope + bVol + bStruct + bVwap) : 0.0

atrPct = atrV / close
slDist = math.min(math.max(atrMult * atrPct, slMinPct), slMaxPct)
longSig  = allowLong  and side == 1  and reqPass and score >= scoreThr and (not useLTF or ltfBull)
shortSig = allowShort and side == -1 and reqPass and score >= scoreThr and (not useLTF or not ltfBull)

plot(ema20, "EMA20", color.new(color.aqua, 0))
plot(ema50, "EMA50", color.new(color.orange, 0))
plotshape(longSig,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(shortSig, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small)

alertcondition(longSig and not longSig[1],   "Multi-Factor LONG",  "MF LONG {{ticker}} @ {{close}}")
alertcondition(shortSig and not shortSig[1], "Multi-Factor SHORT", "MF SHORT {{ticker}} @ {{close}}")
// edge-trigger: alert once at signal ONSET, not every bar the state persists
// (a webhook consumer would otherwise stack a duplicate entry every hour)
if longSig and not longSig[1]
    alert('{"strategy":"multifactor","action":"buy","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"score":' + str.tostring(score) + ',"sl":' + str.tostring(close * (1 - slDist)) + ',"tp":' + str.tostring(close * (1 + slDist * rr)) + '}', alert.freq_once_per_bar_close)
if shortSig and not shortSig[1]
    alert('{"strategy":"multifactor","action":"sell","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"score":' + str.tostring(score) + ',"sl":' + str.tostring(close * (1 + slDist)) + ',"tp":' + str.tostring(close * (1 - slDist * rr)) + '}', alert.freq_once_per_bar_close)
