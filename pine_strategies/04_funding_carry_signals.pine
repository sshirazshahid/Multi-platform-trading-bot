//@version=6
// QuantSuite #4 - Funding/Carry-Aware | INDICATOR (alerts). Separate pane: plots
// the perp-vs-spot premium (funding proxy). Run on the PERP chart.
indicator("QuantSuite #4 Funding/Carry [signals]", overlay=false)
gC = "Funding proxy"
spotSym   = input.symbol("BINANCE:BTCUSDT", "Spot symbol (for basis)", group=gC)
fundSym   = input.string("", "Real funding symbol (optional, overrides proxy)", group=gC)
smoothLen = input.int(8, "Premium smoothing (EMA)", group=gC)
premThr   = input.float(0.05, "Premium threshold (%)", group=gC)
gS = "Trend confirm"
emaFastLen = input.int(20, "EMA fast", group=gS)
emaSlowLen = input.int(50, "EMA slow", group=gS)
adxLen     = input.int(14, "ADX length", group=gS)
adxMin     = input.float(18.0, "ADX minimum", group=gS)
gR = "Risk (for alert SL/TP)"
atrLen   = input.int(14, "ATR length", group=gR)
atrMult  = input.float(1.5, "ATR x for stop", group=gR)
slMinPct = input.float(1.5, "Min stop (%)", group=gR) / 100.0
slMaxPct = input.float(3.5, "Max stop (%)", group=gR) / 100.0
rr       = input.float(2.0, "Reward : Risk", group=gR)
allowLong  = input.bool(true, "Allow longs (carry)", group=gR)
allowShort = input.bool(true, "Allow shorts (fade)", group=gR)

ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaSlowLen)
[diP, diM, adxV] = ta.dmi(adxLen, adxLen)
atrV = ta.atr(atrLen)
useReal = str.length(fundSym) > 0
spotClose = request.security(spotSym, timeframe.period, close)
fSym = useReal ? fundSym : syminfo.tickerid
realFund = request.security(fSym, timeframe.period, close)
basis = na(spotClose) or spotClose == 0 ? 0.0 : (close - spotClose) / spotClose * 100.0
rawFund = useReal ? realFund : basis
fund = ta.ema(rawFund, smoothLen)
longSig  = allowLong  and fund < -premThr and close > ema20 and ema20 > ema50 and adxV >= adxMin
shortSig = allowShort and fund >  premThr and close < ema20 and ema20 < ema50 and adxV >= adxMin
atrPct = atrV / close
slDist = math.min(math.max(atrMult * atrPct, slMinPct), slMaxPct)

plot(fund, "Funding proxy (premium %)", color.new(color.yellow, 0))
plot(premThr, "thr+", color.new(color.red, 50))
plot(-premThr, "thr-", color.new(color.green, 50))
plot(0.0, "flat", color.new(color.gray, 70))
bgcolor(longSig ? color.new(color.green, 80) : shortSig ? color.new(color.red, 80) : na)
alertcondition(longSig and not longSig[1],   "Carry LONG", "CARRY LONG {{ticker}} @ {{close}}")
alertcondition(shortSig and not shortSig[1], "Fade SHORT", "FADE SHORT {{ticker}} @ {{close}}")
// edge-trigger: alert once at signal ONSET (premium/trend states persist for bars)
if longSig and not longSig[1]
    alert('{"strategy":"funding_carry","action":"buy","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"premium":' + str.tostring(fund) + ',"sl":' + str.tostring(close * (1 - slDist)) + ',"tp":' + str.tostring(close * (1 + slDist * rr)) + '}', alert.freq_once_per_bar_close)
if shortSig and not shortSig[1]
    alert('{"strategy":"funding_carry","action":"sell","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"premium":' + str.tostring(fund) + ',"sl":' + str.tostring(close * (1 + slDist)) + ',"tp":' + str.tostring(close * (1 - slDist * rr)) + '}', alert.freq_once_per_bar_close)
