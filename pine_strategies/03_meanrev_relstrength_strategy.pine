//@version=6
// =============================================================================
// QuantSuite #3 - Mean-Reversion + Relative-Strength  |  STRATEGY (backtestable)
// Fade stretched moves back to a rolling VWAP, but ONLY in the direction favoured
// by relative strength vs BTC, and NOT against a strong 4h trend.
//   Long : close < VWAP - kxATR, RSI<low, outperforming BTC, 4h not strong-bear.
//   Short: close > VWAP + kxATR, RSI>high, underperforming BTC, 4h not strong-bull.
// Exit: ATR stop + R:R target (mean-reversion -> use rr ~1.5). Run on 1h.
// =============================================================================
strategy("QuantSuite #3 MeanRev+RS [MTF]", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false)

gT = "Context"
htf   = input.timeframe("240", "Trend-filter TF", group=gT)
btcSym = input.symbol("BINANCE:BTCUSDT.P", "Relative-strength benchmark", group=gT)
gS = "Mean-reversion"
vwapLen  = input.int(24, "Rolling VWAP length", group=gS)
devMult  = input.float(2.0, "Deviation (x ATR) for bands", group=gS)
rsiLen   = input.int(14, "RSI length", group=gS)
rsiLow   = input.float(32.0, "RSI oversold (long)", group=gS)
rsiHigh  = input.float(68.0, "RSI overbought (short)", group=gS)
rsLen    = input.int(48, "Relative-strength lookback (bars)", group=gS)
adxStrong = input.float(28.0, "4h ADX = 'strong trend' block", group=gS)
gR = "Risk"
atrLen   = input.int(14, "ATR length", group=gR)
atrMult  = input.float(1.5, "ATR x for stop", group=gR)
slMinPct = input.float(1.5, "Min stop (%)", group=gR) / 100.0
slMaxPct = input.float(3.5, "Max stop (%)", group=gR) / 100.0
rr       = input.float(1.5, "Reward : Risk", group=gR)
riskPct  = input.float(0.5, "Risk % of equity / trade", group=gR) / 100.0
allowLong  = input.bool(true, "Allow longs", group=gR)
allowShort = input.bool(true, "Allow shorts", group=gR)

hlc3v = (high + low + close) / 3.0
rvwap = math.sum(hlc3v * volume, vwapLen) / math.sum(volume, vwapLen)
rsiV  = ta.rsi(close, rsiLen)
atrV  = ta.atr(atrLen)
lower = rvwap - devMult * atrV
upper = rvwap + devMult * atrV

// relative strength vs BTC (same TF, no lookahead needed)
btcClose = request.security(btcSym, timeframe.period, close)
rsAsset = close / close[rsLen] - 1.0
rsBtc   = btcClose / btcClose[rsLen] - 1.0
rs      = rsAsset - rsBtc
// benchmark bypass (mirrors engine.py is_bench): on the BTC chart itself rs == 0
// exactly, so without this the strategy silently never fires there.
// ticker.standard strips extended-hours/adjustment/non-standard-chart decorations
// so the comparison also holds on e.g. Heikin Ashi charts.
isBench = ticker.standard(syminfo.tickerid) == ticker.standard(btcSym)

// 4h trend filter (non-repainting)
htfAdx() =>
    [p, m, a] = ta.dmi(14, 14)
    a
ema20H = request.security(syminfo.tickerid, htf, ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
ema50H = request.security(syminfo.tickerid, htf, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
adxH   = request.security(syminfo.tickerid, htf, htfAdx()[1], lookahead=barmerge.lookahead_on)
strongBear = ema20H < ema50H and adxH >= adxStrong
strongBull = ema20H > ema50H and adxH >= adxStrong

longSig  = allowLong  and close < lower and rsiV < rsiLow  and (rs > 0 or isBench) and not strongBear
shortSig = allowShort and close > upper and rsiV > rsiHigh and (rs < 0 or isBench) and not strongBull

atrPct = atrV / close
slDist = math.min(math.max(atrMult * atrPct, slMinPct), slMaxPct)
qtyL = slDist > 0 ? (strategy.equity * riskPct) / (close * slDist) : 0.0

if longSig and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=qtyL)
    strategy.exit("L-x", from_entry="Long", stop=close * (1 - slDist), limit=close * (1 + slDist * rr))
if shortSig and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=qtyL)
    strategy.exit("S-x", from_entry="Short", stop=close * (1 + slDist), limit=close * (1 - slDist * rr))

plot(rvwap, "rVWAP", color.new(color.purple, 0))
plot(upper, "Upper", color.new(color.red, 50))
plot(lower, "Lower", color.new(color.green, 50))
plotshape(longSig and strategy.position_size == 0,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(shortSig and strategy.position_size == 0, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small)
