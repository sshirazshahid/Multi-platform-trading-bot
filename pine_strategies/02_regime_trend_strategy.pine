//@version=6
// =============================================================================
// QuantSuite #2 - Regime-Filtered Trend  |  STRATEGY (backtestable)
// Trades only WITH a confirmed 4h regime (EMA20>50>200 stack + ADX>=25), entering
// on a chart-TF pullback re-entry (close re-crosses EMA20) with 1h ADX>=20.
// Fewer, higher-quality trend entries. ATR stop, configurable R:R. Run on 1h.
// =============================================================================
strategy("QuantSuite #2 Regime Trend [MTF]", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false)

gT = "Timeframes"
htf = input.timeframe("240", "Regime TF (trend context)", group=gT)
gS = "Regime / Signal"
emaFastLen  = input.int(20,  "EMA fast", group=gS)
emaSlowLen  = input.int(50,  "EMA slow", group=gS)
emaTrendLen = input.int(200, "EMA trend", group=gS)
adxLen      = input.int(14,  "ADX / DMI length", group=gS)
adxRegime   = input.float(25.0, "4h ADX min (regime)", group=gS)
adx1hMin    = input.float(20.0, "Chart-TF ADX min", group=gS)
gR = "Risk"
atrLen   = input.int(14, "ATR length", group=gR)
atrMult  = input.float(1.8, "ATR x for stop", group=gR)
slMinPct = input.float(1.5, "Min stop (%)", group=gR) / 100.0
slMaxPct = input.float(3.5, "Max stop (%)", group=gR) / 100.0
rr       = input.float(2.5, "Reward : Risk", group=gR)
riskPct  = input.float(0.5, "Risk % of equity / trade", group=gR) / 100.0
allowLong  = input.bool(true, "Allow longs", group=gR)
allowShort = input.bool(true, "Allow shorts", group=gR)

// chart-TF
ema20 = ta.ema(close, emaFastLen)
[diP, diM, adx1h] = ta.dmi(adxLen, adxLen)
atrV = ta.atr(atrLen)

// 4h regime (non-repainting)
htfAdx() =>
    [p, m, a] = ta.dmi(adxLen, adxLen)
    a
ema20H  = request.security(syminfo.tickerid, htf, ta.ema(close, emaFastLen)[1],  lookahead=barmerge.lookahead_on)
ema50H  = request.security(syminfo.tickerid, htf, ta.ema(close, emaSlowLen)[1],  lookahead=barmerge.lookahead_on)
ema200H = request.security(syminfo.tickerid, htf, ta.ema(close, emaTrendLen)[1], lookahead=barmerge.lookahead_on)
adxH    = request.security(syminfo.tickerid, htf, htfAdx()[1], lookahead=barmerge.lookahead_on)

bull = ema20H > ema50H and ema50H > ema200H and adxH >= adxRegime
bear = ema20H < ema50H and ema50H < ema200H and adxH >= adxRegime

longSig  = allowLong  and bull and ta.crossover(close, ema20)  and adx1h >= adx1hMin
shortSig = allowShort and bear and ta.crossunder(close, ema20) and adx1h >= adx1hMin

atrPct = atrV / close
slDist = math.min(math.max(atrMult * atrPct, slMinPct), slMaxPct)
qtyL = slDist > 0 ? (strategy.equity * riskPct) / (close * slDist) : 0.0

if longSig and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty=qtyL)
    strategy.exit("L-x", from_entry="Long", stop=close * (1 - slDist), limit=close * (1 + slDist * rr))
if shortSig and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty=qtyL)
    strategy.exit("S-x", from_entry="Short", stop=close * (1 + slDist), limit=close * (1 - slDist * rr))

plot(ema20, "EMA20", color.new(color.aqua, 0))
bgcolor(bull ? color.new(color.green, 90) : bear ? color.new(color.red, 90) : na, title="Regime")
plotshape(longSig and strategy.position_size == 0,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(shortSig and strategy.position_size == 0, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small)
